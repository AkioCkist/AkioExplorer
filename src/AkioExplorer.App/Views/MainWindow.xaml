<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AkioExplorer.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkioExplorer.App.Controls"
    xmlns:views="using:AkioExplorer.App.Views"
    xmlns:vm="using:AkioExplorer.App.ViewModels"
    xmlns:conv="using:AkioExplorer.App.Converters"
    Title="AkioExplorer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App-wide shortcuts (File Explorer conventions). List-scoped keys (Enter, Del, F2, Backspace) live in FilePane. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Right" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Up" Invoked="OnUpAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="D" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Key="F4" Invoked="OnAddressAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFilterAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="F" Invoked="OnAdvancedSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnFilterAccelerator" />
            <KeyboardAccelerator Key="F3" Invoked="OnFilterAccelerator" />
            <KeyboardAccelerator Key="F6" Invoked="OnSwitchPaneAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="OnNewFolderAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="D" Invoked="OnDualPaneAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="P" Invoked="OnPreviewAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="C" Invoked="OnCopyPathAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number6" Invoked="OnDetailsAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number2" Invoked="OnGridAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Enter" Invoked="OnPropertiesAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnFocusSidebarAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="X" Invoked="OnCutAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="OnPaletteAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="OnNewTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="T" Invoked="OnReopenTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="OnNextTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="OnPreviousTabAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="M" Invoked="OnBatchRenameAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="A" Invoked="OnSelectNoneAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="I" Invoked="OnInvertSelectionAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="N" Invoked="OnNewFileAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="S" Invoked="OnFolderSizesAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="T" Invoked="OnTerminalAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="E" Invoked="OnEditorAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="H" Invoked="OnHiddenItemsAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Custom title bar (draggable region) -->
        <Grid x:Name="AppTitleBar" Height="32" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="AkioExplorer" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False" OpenPaneLength="240"
                        CompactModeThresholdWidth="760" ExpandedModeThresholdWidth="1000"
                        ItemInvoked="OnNavItemInvoked">
            <!-- New tab: the big first thing in the sidebar. Opens a tab with the address bar ready for a path or a
                 pasted link (Google Drive, MEGA, MediaFire, ftp://…). Icon-only when the pane is collapsed. -->
            <NavigationView.PaneCustomContent>
                <Button x:Name="NewTabButton" Style="{StaticResource AccentButtonStyle}" Click="OnNewTabButtonClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="42" Margin="8,6,8,10"
                        Padding="12,0" CornerRadius="8" AutomationProperties.Name="New tab"
                        ToolTipService.ToolTip="New tab: type a path, or paste a Google Drive, Dropbox, OneDrive, Box, MEGA, MediaFire or FTP link (Ctrl+T)">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE710;" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="NewTabLabel" Grid.Column="1" Text="New tab" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="NewTabKeys" Grid.Column="2" Text="Ctrl+T" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </NavigationView.PaneCustomContent>
            <Grid x:Name="ContentRoot">
                <Grid x:Name="ExplorerHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar: commands act on the active pane. Only working commands are shown. -->
                    <!-- Floating glass bar: one step above the pane sheets. -->
                    <!-- Stretches to exactly the panes' width (same 4 / 8 side margins as PanesGrid), so both edges line up;
                         the commands stay left and the overflow button follows them. -->
                    <Border x:Name="ToolbarGlass" HorizontalAlignment="Stretch" Margin="4,4,8,0" Padding="2,0"
                            CornerRadius="{StaticResource GlassCardCornerRadius}" BorderThickness="1"
                            Background="{ThemeResource GlassFloatBackgroundBrush}" BorderBrush="{ThemeResource GlassRimBrush}">
                    <CommandBar x:Name="Toolbar" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent"
                                IsDynamicOverflowEnabled="True">
                        <AppBarButton Label="New folder" Command="{x:Bind ViewModel.ActivePane.NewFolderCommand, Mode=OneWay}"
                                      ToolTipService.ToolTip="New folder (Ctrl+Shift+N)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton Label="Cut" Command="{x:Bind ViewModel.ActivePane.CutCommand, Mode=OneWay}"
                                      ToolTipService.ToolTip="Cut (Ctrl+X)" LabelPosition="Collapsed" Width="44" MinWidth="44">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Copy" Command="{x:Bind ViewModel.ActivePane.CopyCommand, Mode=OneWay}"
                                      ToolTipService.ToolTip="Copy (Ctrl+C)" LabelPosition="Collapsed" Width="44" MinWidth="44">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Paste" Command="{x:Bind ViewModel.ActivePane.PasteCommand, Mode=OneWay}"
                                      ToolTipService.ToolTip="Paste (Ctrl+V)" LabelPosition="Collapsed" Width="44" MinWidth="44">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE77F;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Rename" Command="{x:Bind ViewModel.ActivePane.RenameCommand, Mode=OneWay}"
                                      ToolTipService.ToolTip="Rename (F2)" LabelPosition="Collapsed" Width="44" MinWidth="44">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Delete" Command="{x:Bind ViewModel.ActivePane.DeleteCommand, Mode=OneWay}"
                                      ToolTipService.ToolTip="Delete to Recycle Bin (Del) · Shift+Del deletes permanently" LabelPosition="Collapsed" Width="44" MinWidth="44">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Undo" Command="{x:Bind ViewModel.UndoCommand}"
                                      ToolTipService.ToolTip="Undo (Ctrl+Z)" LabelPosition="Collapsed" Width="44" MinWidth="44">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton Label="Copy to" IsEnabled="{x:Bind ViewModel.ActivePane.HasCopyableSelection, Mode=OneWay}"
                                      ToolTipService.ToolTip="Copy the selection to another folder">
                            <AppBarButton.Icon><FontIcon Glyph="&#xF413;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Other pane" Click="OnCopyToOtherPane">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Choose folder…" Click="OnCopyToFolder">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton Label="Move to" IsEnabled="{x:Bind ViewModel.ActivePane.HasMovableSelection, Mode=OneWay}"
                                      ToolTipService.ToolTip="Move the selection to another folder">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Other pane" Click="OnMoveToOtherPane">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Choose folder…" Click="OnMoveToFolder">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <!-- Cloud-only commands: hidden on this PC instead of greyed out, so they don't push Preview into the overflow. -->
                        <AppBarSeparator Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.ActivePane.IsRemote), Mode=OneWay}" />
                        <AppBarButton Label="Upload" IsEnabled="{x:Bind ViewModel.ActivePane.CanUpload, Mode=OneWay}"
                                      Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.ActivePane.IsRemote), Mode=OneWay}"
                                      ToolTipService.ToolTip="Upload files or a folder from this PC into this cloud folder">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE898;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Files…" Click="OnUploadFiles">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Folder…" Click="OnUploadFolder">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton Label="Download" IsEnabled="{x:Bind ViewModel.ActivePane.CanDownload, Mode=OneWay}"
                                      Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.ActivePane.IsRemote), Mode=OneWay}"
                                      ToolTipService.ToolTip="Download the selection to this PC">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="DownloadToDefault" Text="To Downloads" Click="OnDownloadDefault">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Choose folder…" Click="OnDownloadTo">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="SortButton" Label="Sort" ToolTipService.ToolTip="Sort items">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Opening="OnSortMenuOpening">
                                    <RadioMenuFlyoutItem x:Name="SortName" Text="Name" GroupName="sort" Tag="Name" Click="OnSortFieldClick" />
                                    <RadioMenuFlyoutItem x:Name="SortDate" Text="Date modified" GroupName="sort" Tag="Modified" Click="OnSortFieldClick" />
                                    <RadioMenuFlyoutItem x:Name="SortType" Text="Type" GroupName="sort" Tag="Type" Click="OnSortFieldClick" />
                                    <RadioMenuFlyoutItem x:Name="SortSize" Text="Size" GroupName="sort" Tag="Size" Click="OnSortFieldClick" />
                                    <MenuFlyoutSeparator />
                                    <RadioMenuFlyoutItem x:Name="SortAsc" Text="Ascending" GroupName="dir" Tag="Asc" Click="OnSortDirectionClick" />
                                    <RadioMenuFlyoutItem x:Name="SortDesc" Text="Descending" GroupName="dir" Tag="Desc" Click="OnSortDirectionClick" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="SortFoldersFirst" Text="Folders first" Click="OnFoldersFirstClick"
                                                          ToolTipService.ToolTip="Off: folders and files are ordered together by the chosen field" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton x:Name="ViewButton" Label="View" ToolTipService.ToolTip="Change view">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE890;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Opening="OnViewMenuOpening">
                                    <RadioMenuFlyoutItem x:Name="ViewDetails" Text="Details" GroupName="view" Click="OnViewDetailsClick" KeyboardAcceleratorTextOverride="Ctrl+Shift+6">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <RadioMenuFlyoutItem x:Name="ViewGrid" Text="Grid" GroupName="view" Click="OnViewGridClick" KeyboardAcceleratorTextOverride="Ctrl+Shift+2">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="ViewHidden" Text="Hidden items" Click="OnViewHiddenClick" KeyboardAcceleratorTextOverride="Ctrl+H" />
                                    <ToggleMenuFlyoutItem x:Name="ViewExtensions" Text="File name extensions" Click="OnViewExtensionsClick" />
                                    <ToggleMenuFlyoutItem x:Name="ViewFolderSizes" Text="Folder sizes (this PC)" Click="OnViewFolderSizesClick"
                                                          ToolTipService.ToolTip="Calculate folder sizes automatically as you browse" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Zoom in" Click="OnZoomInMenuClick" KeyboardAcceleratorTextOverride="Ctrl+Plus">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Zoom out" Click="OnZoomOutMenuClick" KeyboardAcceleratorTextOverride="Ctrl+Minus">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Reset zoom" Click="OnZoomResetMenuClick" KeyboardAcceleratorTextOverride="Ctrl+0" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarToggleButton Label="Dual pane" IsChecked="{x:Bind ViewModel.IsDualPane, Mode=TwoWay}"
                                            ToolTipService.ToolTip="Dual pane (Ctrl+Shift+D) · F6 switches pane">
                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8A4;" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton x:Name="PreviewToggle" Label="Preview" IsChecked="{x:Bind ViewModel.IsPreviewOpen, Mode=TwoWay}"
                                            ToolTipService.ToolTip="Preview pane (Alt+P)">
                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE89F;" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <!-- Power tools live in the overflow menu to keep the bar short; every one is also in the command palette. -->
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Command palette…" KeyboardAcceleratorTextOverride="Ctrl+Shift+P" Click="OnPaletteClick">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="New tab" KeyboardAcceleratorTextOverride="Ctrl+T" Command="{x:Bind ViewModel.ActivePane.NewTabCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE737;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="New text document" KeyboardAcceleratorTextOverride="Ctrl+Alt+N" Command="{x:Bind ViewModel.ActivePane.NewTextFileCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Rename many…" KeyboardAcceleratorTextOverride="Ctrl+M" Command="{x:Bind ViewModel.ActivePane.BatchRenameCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="Invert selection" KeyboardAcceleratorTextOverride="Ctrl+I" Command="{x:Bind ViewModel.ActivePane.InvertSelectionCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE762;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Select by pattern…" Click="OnSelectByPatternClick">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE71C;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Compare panes" Click="OnComparePanesClick" IsEnabled="{x:Bind ViewModel.IsDualPane, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="Compress to ZIP" Command="{x:Bind ViewModel.ActivePane.CompressCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xF012;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Extract to folder" Command="{x:Bind ViewModel.ActivePane.ExtractToFolderCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Checksums…" Command="{x:Bind ViewModel.ActivePane.ChecksumCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Calculate folder sizes" KeyboardAcceleratorTextOverride="Ctrl+Alt+S" Command="{x:Bind ViewModel.ActivePane.CalculateFolderSizesCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xEDA2;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Open in Terminal" KeyboardAcceleratorTextOverride="Ctrl+Alt+T" Command="{x:Bind ViewModel.ActivePane.OpenTerminalCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE756;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="{x:Bind ViewModel.ActivePane.TrashLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ActivePane.OpenTrashCommand, Mode=OneWay}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    </Border>

                    <Grid x:Name="PanesGrid" Grid.Row="1" Margin="4,8,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="RightColumn" Width="0" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <controls:FilePane x:Name="LeftPaneView" ViewModel="{x:Bind ViewModel.LeftPane}" />
                        <!-- Gap between the two pane sheets (Mica shows through) -->
                        <Rectangle x:Name="PaneDivider" Grid.Column="1" Width="8" Visibility="Collapsed" Fill="Transparent" />
                        <controls:FilePane x:Name="RightPaneView" Grid.Column="2" Visibility="Collapsed" ViewModel="{x:Bind ViewModel.RightPane}" />
                        <controls:PaneSplitter x:Name="PreviewSplitter" Grid.Column="3" Visibility="Collapsed" />
                        <controls:PreviewPane x:Name="PreviewView" Grid.Column="4" Visibility="Collapsed" />
                    </Grid>

                    <!-- Running copy / move operations (only operations longer than ~0.6 s appear) -->
                    <Border Grid.Row="2" Margin="4,0,8,8" Padding="16,8,8,8" BorderThickness="1"
                            CornerRadius="{StaticResource GlassCardCornerRadius}"
                            Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource GlassRimBrush}"
                            Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.Operations.HasItems), Mode=OneWay}">
                        <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <HyperlinkButton Content="View all transfers" HorizontalAlignment="Right" Padding="8,2" FontSize="12" Click="OnViewTransfers" />
                        <ScrollViewer Grid.Row="1" MaxHeight="176" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Operations.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OperationItemViewModel">
                                        <Grid ColumnSpacing="12" RowSpacing="4" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="2*" MinWidth="80" />
                                                <ColumnDefinition Width="*" MinWidth="80" MaxWidth="220" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- Multi-connection downloads: compact part bars (file name on hover) -->
                                            <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{x:Bind Parts}"
                                                          Visibility="{x:Bind conv:XamlHelpers.Visible(HasParts), Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PartedFileViewModel">
                                                        <Grid ColumnSpacing="8" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <controls:SegmentBar Height="5" VerticalAlignment="Center"
                                                                                 Segments="{x:Bind Segments, Mode=OneWay}" Total="{x:Bind Total, Mode=OneWay}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Summary, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="2" VerticalAlignment="Center" Maximum="100" ShowPaused="{x:Bind IsPaused, Mode=OneWay}"
                                                         Value="{x:Bind Progress, Mode=OneWay}"
                                                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                         ShowError="{x:Bind HasProblem, Mode=OneWay}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind PauseOrResumeCommand}"
                                                        Visibility="{x:Bind conv:XamlHelpers.Visible(IsRunning), Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind PauseLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind PauseLabel, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind PauseGlyph, Mode=OneWay}" FontSize="14" />
                                                </Button>
                                                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind RetryCommand}"
                                                        Visibility="{x:Bind conv:XamlHelpers.Visible(CanRetry), Mode=OneWay}"
                                                        ToolTipService.ToolTip="Retry (files that already arrived are skipped)" AutomationProperties.Name="Retry">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                </Button>
                                                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind CancelOrDismissCommand}"
                                                        ToolTipService.ToolTip="Cancel or dismiss" AutomationProperties.Name="Cancel or dismiss">
                                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </NavigationView>
    </Grid>
</Window>
