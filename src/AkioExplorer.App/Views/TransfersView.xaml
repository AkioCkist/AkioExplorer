<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkioExplorer.App.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkioExplorer.App.ViewModels"
    xmlns:conv="using:AkioExplorer.App.Converters">

    <Grid Padding="32,24,32,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Transfers" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PauseAllButton" Command="{x:Bind Operations.PauseAllCommand}" ToolTipService.ToolTip="Pause every running transfer">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE769;" FontSize="14" /><TextBlock Text="Pause all" /></StackPanel>
                </Button>
                <Button x:Name="ResumeAllButton" Command="{x:Bind Operations.ResumeAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Resume all" /></StackPanel>
                </Button>
                <Button x:Name="ClearHistoryButton" Command="{x:Bind History.ClearCommand}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Clear history" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="QueueTab" Text="Queue" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE896;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="HistoryTab" Text="Recent">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE81C;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- Queue -->
        <Grid x:Name="QueuePanel" Grid.Row="2">
            <ListView ItemsSource="{x:Bind Operations.Queue}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OperationItemViewModel">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Route}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar Grid.Column="2" VerticalAlignment="Center" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" ShowPaused="{x:Bind IsPaused, Mode=OneWay}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind PauseOrResumeCommand}"
                                        ToolTipService.ToolTip="{x:Bind PauseLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind PauseLabel, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind PauseGlyph, Mode=OneWay}" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind CancelOrDismissCommand}"
                                        ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel transfer">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False"
                        Visibility="{x:Bind conv:XamlHelpers.Collapsed(Operations.HasQueue), Mode=OneWay}">
                <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Nothing is transferring right now." TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Copy, move, upload or download files and they appear here." TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- History -->
        <Grid x:Name="HistoryPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar Severity="Warning" IsClosable="True" Message="{x:Bind History.Message, Mode=OneWay}"
                     IsOpen="{x:Bind conv:XamlHelpers.HasText(History.Message), Mode=OneWay}" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind History.Records}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransferRecordViewModel">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Route}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ErrorText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind conv:XamlHelpers.Visible(HasError)}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Retry" Click="OnRetryRecord" Tag="{x:Bind}" Visibility="{x:Bind conv:XamlHelpers.Visible(CanRetry)}" />
                                <Button Style="{StaticResource ToolIconButtonStyle}" Click="OnRemoveRecord" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Remove from list" AutomationProperties.Name="Remove from list">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False"
                        Visibility="{x:Bind conv:XamlHelpers.Collapsed(History.HasRecords), Mode=OneWay}">
                <FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No recent transfers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
