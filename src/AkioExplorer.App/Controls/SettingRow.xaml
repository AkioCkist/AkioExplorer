<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkioExplorer.App.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">
    <Border MinHeight="64" Padding="16,10,16,10" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="Icon" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="HeaderText" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ContentPresenter x:Name="ActionPresenter" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
