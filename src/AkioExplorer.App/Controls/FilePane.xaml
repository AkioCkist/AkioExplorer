<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkioExplorer.App.Controls.FilePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkioExplorer.App.ViewModels"
    xmlns:models="using:AkioExplorer.Core.Models"
    xmlns:conv="using:AkioExplorer.App.Converters">

    <UserControl.Resources>
        <!-- Details row: compiled bindings, no converters, icon loads when the row is realised. -->
        <DataTemplate x:Key="DetailsRowTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Height="32" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Bind Columns.DateWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.TypeWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.SizeWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>
                <Border x:Name="DropHighlight" x:Load="{x:Bind IsDropTarget, Mode=OneWay}" Grid.ColumnSpan="5" Margin="-8,1,-8,1"
                        CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}" Opacity="0.35" />
                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="0,0,12,0" ColumnSpacing="6" Visibility="{x:Bind conv:XamlHelpers.Collapsed(IsRenaming), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- Marks kept on the cloud service: colour label, favourite -->
                    <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Center" Fill="{x:Bind LabelBrush, Mode=OneWay}"
                             Visibility="{x:Bind conv:XamlHelpers.Visible(HasLabel), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LabelName, Mode=OneWay}" />
                    <FontIcon Grid.Column="2" Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Foreground="#F5C30F"
                              Visibility="{x:Bind conv:XamlHelpers.Visible(IsStarred), Mode=OneWay}" ToolTipService.ToolTip="Favourite" />
                </Grid>
                <TextBox Grid.Column="1" x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}"
                         Text="{x:Bind EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="28" Height="28" Padding="8,3,8,0" Margin="-9,0,12,0" VerticalAlignment="Center"
                         Loaded="OnRenameBoxLoaded" KeyDown="OnRenameBoxKeyDown" LostFocus="OnRenameBoxLostFocus" />
                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind SecondaryText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GridTileTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Width="108" Height="132" Padding="6,8,6,4" RowSpacing="4" Opacity="{x:Bind Opacity, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="TileDropHighlight" x:Load="{x:Bind IsDropTarget, Mode=OneWay}" Grid.RowSpan="2" Margin="-6,-8,-6,-4"
                        CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}" Opacity="0.35" />
                <!-- Type icon until (and unless) a picture thumbnail arrives -->
                <Image Source="{x:Bind LargeIcon, Mode=OneWay}" Width="48" Height="48"
                       Visibility="{x:Bind conv:XamlHelpers.Collapsed(HasThumbnail), Mode=OneWay}" />
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" MaxWidth="96" MaxHeight="64" Stretch="Uniform"
                       Visibility="{x:Bind conv:XamlHelpers.Visible(HasThumbnail), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{x:Bind LabelBrush, Mode=OneWay}"
                             Visibility="{x:Bind conv:XamlHelpers.Visible(HasLabel), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="#F5C30F" Visibility="{x:Bind conv:XamlHelpers.Visible(IsStarred), Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="4">
                    <!-- Rename in grid view happens in a wide popup under the tile (RenamePopup), not in this narrow cell. -->
                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="DriveBar" x:Load="{x:Bind IsDrive}" Value="{x:Bind DriveUsage, Mode=OneWay}" Maximum="100" Margin="6,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="BackgroundMenu">
                <MenuFlyoutItem Text="Paste" Command="{x:Bind ViewModel.PasteCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+V">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="View">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE890;" /></MenuFlyoutSubItem.Icon>
                    <RadioMenuFlyoutItem x:Name="MenuViewDetails" Text="Details" GroupName="view" Click="OnMenuViewDetails" KeyboardAcceleratorTextOverride="Ctrl+Shift+6" />
                    <RadioMenuFlyoutItem x:Name="MenuViewGrid" Text="Grid" GroupName="view" Click="OnMenuViewGrid" KeyboardAcceleratorTextOverride="Ctrl+Shift+2" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Sort by">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutSubItem.Icon>
                    <RadioMenuFlyoutItem x:Name="MenuSortName" Text="Name" GroupName="sort" Click="OnMenuSort" Tag="Name" />
                    <RadioMenuFlyoutItem x:Name="MenuSortDate" Text="Date modified" GroupName="sort" Click="OnMenuSort" Tag="Modified" />
                    <RadioMenuFlyoutItem x:Name="MenuSortType" Text="Type" GroupName="sort" Click="OnMenuSort" Tag="Type" />
                    <RadioMenuFlyoutItem x:Name="MenuSortSize" Text="Size" GroupName="sort" Click="OnMenuSort" Tag="Size" />
                    <MenuFlyoutSeparator />
                    <RadioMenuFlyoutItem x:Name="MenuSortAsc" Text="Ascending" GroupName="dir" Click="OnMenuSortDirection" Tag="Asc" />
                    <RadioMenuFlyoutItem x:Name="MenuSortDesc" Text="Descending" GroupName="dir" Click="OnMenuSortDirection" Tag="Desc" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="F5">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="MenuNew" Text="New">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem Text="Folder" Command="{x:Bind ViewModel.NewFolderCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+N">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuNewFile" Text="Text document" Command="{x:Bind ViewModel.NewTextFileCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Alt+N">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator x:Name="MenuNewTabSeparator" />
                    <MenuFlyoutItem Text="Tab" Command="{x:Bind ViewModel.NewTabCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+T">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE737;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Select">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem Text="Select all" Command="{x:Bind ViewModel.SelectAllCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+A" />
                    <MenuFlyoutItem Text="Select none" Command="{x:Bind ViewModel.SelectNoneCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+A" />
                    <MenuFlyoutItem Text="Invert selection" Command="{x:Bind ViewModel.InvertSelectionCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+I" />
                    <MenuFlyoutItem Text="Select by pattern…" Click="OnSelectByPattern" KeyboardAcceleratorTextOverride="Num +" />
                    <MenuFlyoutItem Text="Deselect by pattern…" Click="OnDeselectByPattern" KeyboardAcceleratorTextOverride="Num -" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuBgEditor" Text="Open in VS Code" Command="{x:Bind ViewModel.OpenInEditorCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="MenuBgOpenIn" Text="Open in">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem x:Name="MenuBgTerminal" Text="Terminal" Command="{x:Bind ViewModel.OpenTerminalCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Alt+T">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuBgBrowser" Text="Browser" Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuBgExplorer" Text="File Explorer" Command="{x:Bind ViewModel.RevealInExplorerCommand, Mode=OneWay}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Other pane" Click="OnOpenInOtherPane">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A4;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <!-- Items from installed apps (Git Bash here, Visual Studio, Everything…), added at runtime. -->
                <MenuFlyoutSubItem x:Name="MenuBgShellMore" Text="More options">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE712;" /></MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuPinCurrent" Text="Pin to Favorites" Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy path" Command="{x:Bind ViewModel.CopyPathCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+C">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuBgSizes" Text="Calculate folder sizes" Command="{x:Bind ViewModel.CalculateFolderSizesCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Alt+S">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDA2;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuBgProperties" Text="Properties" Command="{x:Bind ViewModel.ShowPropertiesCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Alt+Enter">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>

        <!-- Active pane indicator (dual-pane only) -->
        <Rectangle Height="2" VerticalAlignment="Top" Margin="12,0" RadiusX="1" RadiusY="1"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                   Opacity="{x:Bind conv:XamlHelpers.ActiveIndicatorOpacity(ViewModel.ShowActiveIndicator, ViewModel.IsActive), Mode=OneWay}" />

        <!-- Navigation bar: tabs (once there are two), history buttons, breadcrumb / address box, filter -->
        <StackPanel Grid.Row="0">
        <TabView x:Name="TabStrip" TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.ActiveTab, Mode=OneWay}"
                 Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.HasTabs), Mode=OneWay}"
                 SelectionChanged="OnTabSelectionChanged" TabCloseRequested="OnTabCloseRequested" AddTabButtonClick="OnAddTabClick"
                 CanReorderTabs="True" CanDragTabs="False" AllowDropTabs="False" TabWidthMode="Equal" IsTabStop="False"
                 Margin="4,4,4,0" AutomationProperties.Name="Tabs">
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
            </TabView.Resources>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:PaneTab">
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                        <TabViewItem.IconSource><FontIconSource Glyph="&#xE8B7;" /></TabViewItem.IconSource>
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Close tab" Click="OnCloseTabMenu" KeyboardAcceleratorTextOverride="Ctrl+W" />
                                <MenuFlyoutItem Text="Close other tabs" Click="OnCloseOtherTabsMenu" />
                                <MenuFlyoutItem Text="Duplicate tab" Click="OnDuplicateTabMenu" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
        <Grid Padding="{StaticResource PaneBarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="FilterColumn" Width="240" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind ViewModel.GoForwardCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind ViewModel.GoUpCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Up to parent folder (Alt+Up)" AutomationProperties.Name="Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>

            <Grid x:Name="AddressHost" Grid.Column="1" Height="32" CornerRadius="{ThemeResource ControlCornerRadius}"
                  Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1" Tapped="OnAddressTapped" ToolTipService.ToolTip="Click to type a path (Ctrl+L)">
                <BreadcrumbBar x:Name="Crumbs" ItemsSource="{x:Bind ViewModel.Breadcrumb, Mode=OneWay}" ItemClicked="OnCrumbClicked"
                               VerticalAlignment="Center" Margin="6,0,6,0" />
                <AutoSuggestBox x:Name="AddressBox" Visibility="Collapsed" VerticalAlignment="Center" BorderThickness="0" Margin="-1"
                                QuerySubmitted="OnAddressSubmitted" TextChanged="OnAddressTextChanged" KeyDown="OnAddressKeyDown"
                                LostFocus="OnAddressLostFocus" AutomationProperties.Name="Address" UpdateTextOnSelect="True" />
            </Grid>

            <AutoSuggestBox x:Name="FilterBox" Grid.Column="2" VerticalAlignment="Center"
                            PlaceholderText="{x:Bind ViewModel.FilterPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find" QuerySubmitted="OnFilterSubmitted" KeyDown="OnFilterKeyDown"
                            GotFocus="OnFilterGotFocus" LostFocus="OnSearchAreaLostFocus"
                            TextChanged="OnFilterTextChanged" SuggestionChosen="OnRecentSearchChosen" UpdateTextOnSelect="True"
                            ToolTipService.ToolTip="Type to filter this folder. Press Enter to search subfolders too. (Ctrl+F)"
                            AutomationProperties.Name="Filter and search">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <!-- Search filters (Google Drive style): shown while searching, when a filter is set, or when the search box has focus. -->
        <ScrollViewer x:Name="SearchChipsHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" Margin="8,0,8,6">
            <StackPanel x:Name="SearchChips" Orientation="Horizontal" Spacing="6" GettingFocus="OnChipsGettingFocus" LostFocus="OnSearchAreaLostFocus">
                <DropDownButton x:Name="TypeChip" Height="28" Padding="10,0,8,0" AutomationProperties.Name="Type filter"
                                ToolTipService.ToolTip="Show only one kind of item" />
                <DropDownButton x:Name="PeopleChip" Height="28" Padding="10,0,8,0" AutomationProperties.Name="People filter"
                                ToolTipService.ToolTip="Filter by owner" />
                <DropDownButton x:Name="ModifiedChip" Height="28" Padding="10,0,8,0" AutomationProperties.Name="Date modified filter"
                                ToolTipService.ToolTip="Show only items changed in this period" />
                <DropDownButton x:Name="SizeChip" Height="28" Padding="10,0,8,0" AutomationProperties.Name="Size filter"
                                ToolTipService.ToolTip="Show only files of this size" />
                <DropDownButton x:Name="ScopeChip" Height="28" Padding="10,0,8,0" AutomationProperties.Name="Search location"
                                ToolTipService.ToolTip="Where to search" />
                <Button x:Name="AdvancedSearchButton" Height="28" Padding="10,0" Click="OnAdvancedSearchClick"
                        ToolTipService.ToolTip="All search options in one place (Ctrl+Shift+F)" AutomationProperties.Name="Advanced search">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="12" />
                        <TextBlock Text="Advanced search" />
                    </StackPanel>
                </Button>
                <HyperlinkButton x:Name="ClearFiltersButton" Height="28" Padding="8,0" Content="Clear filters" Click="OnClearFiltersClick"
                                 Visibility="Collapsed" ToolTipService.ToolTip="Remove all search filters (Esc)" />
            </StackPanel>
        </ScrollViewer>
        </StackPanel>

        <InfoBar Grid.Row="1" Margin="8,0,8,6" IsClosable="True"
                 Severity="{x:Bind conv:XamlHelpers.Severity(ViewModel.IsMessageError), Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Reconnect" Click="OnReconnectClick" Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.CanReconnect), Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Column headers (details view) -->
        <Grid x:Name="ColumnHeader" Grid.Row="2" x:Load="{x:Bind ViewModel.IsDetailsView, Mode=OneWay}" Margin="4,0,16,0" Padding="0,0,0,2"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.DateWidth, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.TypeWidth, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.SizeWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>
            <Button Grid.ColumnSpan="2" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnHeaderClick" Tag="Name">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Name" />
                    <FontIcon FontSize="10" Glyph="{x:Bind conv:XamlHelpers.SortGlyph('Name', ViewModel.SortField, ViewModel.SortDescending), Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnHeaderClick" Tag="Modified">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Date modified" />
                    <FontIcon FontSize="10" Glyph="{x:Bind conv:XamlHelpers.SortGlyph('Modified', ViewModel.SortField, ViewModel.SortDescending), Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnHeaderClick" Tag="Type">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.SecondaryColumnHeader, Mode=OneWay}" />
                    <FontIcon FontSize="10" Glyph="{x:Bind conv:XamlHelpers.SortGlyph('Type', ViewModel.SortField, ViewModel.SortDescending), Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="OnHeaderClick" Tag="Size">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="10" Glyph="{x:Bind conv:XamlHelpers.SortGlyph('Size', ViewModel.SortField, ViewModel.SortDescending), Mode=OneWay}" />
                    <TextBlock Text="Size" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Content -->
        <!-- Drop target is the host, not the ListView: ListView swallows drops between lists for its own reordering. -->
        <Grid x:Name="ContentHost" Grid.Row="3" Background="Transparent" AllowDrop="True"
              DragEnter="OnListDragEnter" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="ItemMenu">
                    <!-- Compact: what people use every day at the top level, everything else one level down (Hick's law). -->
                    <MenuFlyoutItem x:Name="MenuOpen" Text="Open" FontWeight="SemiBold" Command="{x:Bind ViewModel.OpenSelectedCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Enter">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuOpenBrowser" Text="Open in browser" Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <!-- Text and icon come from the preferred editor found on this PC (VS Code first). -->
                    <MenuFlyoutItem x:Name="MenuOpenEditor" Text="Open in VS Code" Command="{x:Bind ViewModel.OpenInEditorCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem x:Name="MenuOpenWith" Text="Open with">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7AC;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="MenuOpenIn" Text="Open in">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuOpenTab" Text="New tab" Command="{x:Bind ViewModel.OpenSelectionInNewTabCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Middle-click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE737;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuOpenOther" Text="Other pane" Click="OnOpenInOtherPane">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A4;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuTerminal" Text="Terminal" Command="{x:Bind ViewModel.OpenTerminalCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Alt+T">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuReveal" Text="File Explorer" Command="{x:Bind ViewModel.RevealInExplorerCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Cut" Command="{x:Bind ViewModel.CutCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+X">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+C">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copy path" Command="{x:Bind ViewModel.CopyPathCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Shift+C">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuShare" Text="Share…" Command="{x:Bind ViewModel.ShareCommand, Mode=OneWay}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuCopyLink" Text="Copy link" Command="{x:Bind ViewModel.CopyLinkCommand, Mode=OneWay}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="MenuRename" Text="Rename" Command="{x:Bind ViewModel.RenameCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="F2">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Del">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="MenuOrganize" Text="Organize">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuBatchRename" Text="Rename many…" Command="{x:Bind ViewModel.BatchRenameCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+M">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuFolderFromSelection" Text="New folder from selection" Command="{x:Bind ViewModel.NewFolderFromSelectionCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuDuplicate" Text="Duplicate" Command="{x:Bind ViewModel.DuplicateCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF413;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuPinItem" Text="Pin to Favorites" Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuCopyName" Text="Copy name" Command="{x:Bind ViewModel.CopyNameCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <!-- Marks and history kept on the cloud service (MEGA, Google Drive) -->
                    <MenuFlyoutSubItem x:Name="MenuCloud" Text="Cloud">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE753;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuStar" Text="Add to favourites" Command="{x:Bind ViewModel.ToggleStarCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="MenuLabel" Text="Label">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8EC;" /></MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Name="MenuCloudHide" Text="Hide" Command="{x:Bind ViewModel.ToggleCloudHiddenCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="MenuDownloadAs" Text="Download as">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Name="MenuConvert" Text="Make a Google copy (Docs/Sheets/Slides)" Command="{x:Bind ViewModel.ConvertToOnlineCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuAddShortcut" Text="Add shortcut to My Drive" Command="{x:Bind ViewModel.AddShortcutCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuComments" Text="Comments…" Command="{x:Bind ViewModel.ShowCommentsCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90A;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuActivity" Text="Activity…" Command="{x:Bind ViewModel.ShowActivityCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuDescription" Text="Description…" Command="{x:Bind ViewModel.EditDescriptionCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuLock" Text="Lock / unlock editing" Command="{x:Bind ViewModel.ToggleLockCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuVersions" Text="Versions…" Command="{x:Bind ViewModel.ShowVersionsCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuRemoveLink" Text="Turn off link…" Command="{x:Bind ViewModel.RemoveLinkCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="MenuArchive" Text="Archive">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xF012;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuCompress" Text="Compress to ZIP" Command="{x:Bind ViewModel.CompressCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF012;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuExtractHere" Text="Extract here" Command="{x:Bind ViewModel.ExtractHereCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuExtractFolder" Text="Extract to folder" Command="{x:Bind ViewModel.ExtractToFolderCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <!-- The other pane first, then Windows' own "Send to" targets (added at runtime). -->
                    <MenuFlyoutSubItem x:Name="MenuSendTo" Text="Send to">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE724;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuCopyOther" Text="Copy to other pane" Command="{x:Bind ViewModel.RequestCopyToOtherPaneCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF413;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuMoveOther" Text="Move to other pane" Command="{x:Bind ViewModel.RequestMoveToOtherPaneCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DE;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="MenuSendToSeparator" />
                    </MenuFlyoutSubItem>
                    <!-- Items from installed apps (WinRAR, Notepad++, Photos, Zalo, ShareX…), added at runtime. -->
                    <MenuFlyoutSubItem x:Name="MenuShellMore" Text="More options">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE712;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="MenuTools" Text="More tools">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuChecksum" Text="Checksums (MD5, SHA)…" Command="{x:Bind ViewModel.ChecksumCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuFolderSize" Text="Calculate size" Command="{x:Bind ViewModel.CalculateFolderSizesCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Ctrl+Alt+S">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDA2;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Select same type" Command="{x:Bind ViewModel.SelectSameTypeCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="MenuAttrSeparator" />
                        <ToggleMenuFlyoutItem x:Name="MenuHiddenAttr" Text="Hidden" Command="{x:Bind ViewModel.ToggleHiddenAttributeCommand, Mode=OneWay}" />
                        <ToggleMenuFlyoutItem x:Name="MenuReadOnlyAttr" Text="Read-only" Command="{x:Bind ViewModel.ToggleReadOnlyAttributeCommand, Mode=OneWay}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="MenuProperties" Text="Properties" Command="{x:Bind ViewModel.ShowPropertiesCommand, Mode=OneWay}" KeyboardAcceleratorTextOverride="Alt+Enter">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>

            <ListView x:Name="DetailsList" x:Load="{x:Bind ViewModel.IsDetailsView, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      ItemTemplate="{StaticResource DetailsRowTemplate}"
                      ItemContainerStyle="{StaticResource FileRowContainerStyle}"
                      SelectionMode="Extended" IsItemClickEnabled="False" Padding="0,2,0,8"
                      CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted"
                      AutomationProperties.Name="Files"
                      SelectionChanged="OnListSelectionChanged" DoubleTapped="OnListDoubleTapped"
                      PreviewKeyDown="OnListPreviewKeyDown" CharacterReceived="OnListCharacterReceived"
                      ContainerContentChanging="OnContainerContentChanging" ContextRequested="OnListContextRequested" />

            <GridView x:Name="TilesGrid" x:Load="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      ItemTemplate="{StaticResource GridTileTemplate}"
                      ItemContainerStyle="{StaticResource FileTileContainerStyle}"
                      SelectionMode="Extended" IsItemClickEnabled="False" Padding="10,6,10,8"
                      CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted"
                      AutomationProperties.Name="Files"
                      SelectionChanged="OnListSelectionChanged" DoubleTapped="OnListDoubleTapped"
                      PreviewKeyDown="OnListPreviewKeyDown" CharacterReceived="OnListCharacterReceived"
                      ContainerContentChanging="OnContainerContentChanging" ContextRequested="OnListContextRequested" />

            <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Margin="12,0"
                         Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.IsLoading), Mode=OneWay}" />
            <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Margin="12,0" ShowPaused="False"
                         Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.IsSearching), Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False"
                        Visibility="{x:Bind conv:XamlHelpers.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Shown only while dragging: a large target for "this folder", since a full folder leaves no empty
                 space to drop on (every spot is some subfolder). Hit-tested by position in code. -->
            <Border x:Name="DropBar" VerticalAlignment="Bottom" Margin="12,0,20,12" MinHeight="56" Padding="16,10"
                    CornerRadius="8" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DropBarGlyph" Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DropBarText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DropBarHint" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Drop here for this folder · on a folder to put it inside" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Padding="14,2,8,4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Style="{StaticResource StatusTextStyle}" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="DetailsToggle" Width="32" Height="28" Padding="0" Click="OnDetailsToggleClick" ToolTipService.ToolTip="Details (Ctrl+Shift+6)"
                              AutomationProperties.Name="Details view" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                </ToggleButton>
                <ToggleButton x:Name="GridToggle" Width="32" Height="28" Padding="0" Click="OnGridToggleClick" ToolTipService.ToolTip="Grid (Ctrl+Shift+2)"
                              AutomationProperties.Name="Grid view" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
