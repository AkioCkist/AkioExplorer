<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AkioExplorer.App.Controls.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkioExplorer.App.Controls">

    <!-- Preview of the active pane's selection: content on top, OneCommander-style details below. -->
    <Grid x:Name="Root" Padding="12" RowSpacing="12" CornerRadius="{StaticResource GlassCardCornerRadius}" BorderThickness="1"
          Background="{ThemeResource GlassCardBackgroundBrush}" BorderBrush="{ThemeResource GlassRimBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ContentRow" Height="*" />
            <RowDefinition x:Name="DetailsRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: icon, name, type -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="HeaderIcon" Width="32" Height="32" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                           MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="HeaderType" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid x:Name="ContentHost" Grid.Row="1" CornerRadius="{StaticResource ControlCornerRadius}"
              Background="{ThemeResource GlassInsetBackgroundBrush}" BorderBrush="{ThemeResource GlassInsetBorderBrush}"
              BorderThickness="1" MinHeight="120">
            <Image x:Name="ImageView" Stretch="Uniform" Visibility="Collapsed" Margin="4" />

            <ScrollViewer x:Name="TextScroller" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto" Padding="10,8">
                <TextBlock x:Name="TextView" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
            </ScrollViewer>

            <ScrollViewer x:Name="PdfScroller" Visibility="Collapsed" Padding="6">
                <StackPanel x:Name="PdfPages" Spacing="6" />
            </ScrollViewer>

            <Grid x:Name="MediaHost" Visibility="Collapsed" />

            <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        Padding="16" Visibility="Collapsed">
                <FontIcon x:Name="MessageGlyph" Glyph="&#xE8A5;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ProgressRing x:Name="Loading" IsActive="False" Width="28" Height="28" />

            <TextBlock x:Name="ContentNote" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,4"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="Collapsed" />
        </Grid>

        <!-- Details -->
        <ScrollViewer x:Name="DetailsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DetailsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="controls:PreviewDetail">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
